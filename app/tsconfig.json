{
  "extends": "../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "paraglide/**/*.ts",
    "paraglide/**/*.js"
  ],
  "exclude": ["node_modules", "dist", "src/test/**"],
  "compilerOptions": {
    "tsBuildInfoFile": ".tsbuildinfo-app",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./*"]
    }
  }
}
